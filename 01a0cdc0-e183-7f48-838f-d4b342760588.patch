+  background:repeating-linear-gradient(90deg,#161616 0 2px,#2e2e2e 2px 3px);box-shadow:inset 0 -2px 0 rgba(255,255,255,.08)}
+.vial::after{content:"";position:absolute;left:6px;top:6px;bottom:8px;width:4px;border-radius:3px;background:linear-gradient(rgba(255,240,210,.75),rgba(255,230,190,.12))}
+.vial:hover{transform:translateY(-3px)}
+.vial.lie{width:var(--l);height:30px;margin:0 13px 0 0;border-radius:6px 4px 4px 6px;
+  background:linear-gradient(180deg,#4a1f03,#9a4e12 18%,#d98d35 34%,#f0b563 40%,#b86a1f 52%,#7a3a0a 80%,#3e1a02)}
+.vial.lie::before{left:auto;right:-13px;top:1px;bottom:1px;height:auto;width:14px;border-radius:1px 3px 3px 1px;background:repeating-linear-gradient(180deg,#161616 0 2px,#2e2e2e 2px 3px)}
+.vial.lie::after{left:6px;right:8px;top:5px;bottom:auto;width:auto;height:4px;background:linear-gradient(90deg,rgba(255,240,210,.75),rgba(255,230,190,.12))}
