+.r-pad .r-btn:nth-child(4){border-radius:4px 4px 4px 9px}
+.r-pad .r-btn:nth-child(5){border-radius:4px 4px 9px 4px}
+.r-slot{position:absolute;bottom:10px;left:50%;width:34px;height:14px;transform:translateX(-50%);border-radius:6px 6px 3px 3px;background:#080808;box-shadow:inset 0 2px 3px rgba(0,0,0,.8)}
+
+/* tomes */
+.tomes{display:flex;gap:4px;align-items:flex-end;filter:drop-shadow(26px 12px 16px rgba(0,0,0,.16))}
+.tome{position:relative;width:60px;height:322px;border:0;border-radius:4px;cursor:pointer;transition:transform .35s cubic-bezier(.3,1.5,.5,1);
+  background:repeating-linear-gradient(0deg,rgba(0,0,0,.03) 0 1px,transparent 1px 3px),repeating-linear-gradient(90deg,rgba(0,0,0,.025) 0 1px,transparent 1px 3px),linear-gradient(90deg,#b2ac9a,#d0cbba 15%,#cdc7b6 82%,#aaa38f)}
+.tome span{position:absolute;top:30px;left:50%;transform:translateX(-50%);writing-mode:vertical-rl;font:500 19px var(--serif);letter-spacing:.06em;color:#94784a;text-shadow:0 1px 0 rgba(255,255,255,.35);white-space:nowrap}
+.tome.t2{width:64px;height:328px}
+.tome.t2 span{font-size:17.5px;top:22px}
+.tome.t2::after{content:"";position:absolute;right:-9px;top:4px;bottom:4px;width:9px;border-radius:0 3px 3px 0;background:repeating-linear-gradient(90deg,#f3efe6 0 1px,#d9d2c3 1px 2px)}
+.tome:hover,.tome:focus-visible{transform:translateY(-16px)}
+
+/* visitor pass */
+.pass-wrap{position:relative;width:350px;height:440px;transform-origin:top right}
+.pass-strap{position:absolute;inset:0;width:100%;height:100%;overflow:visible;filter:drop-shadow(10px 12px 10px rgba(0,0,0,.18))}
+.ps-base{fill:none;stroke:var(--navy);stroke-width:20;stroke-linecap:round}
+.ps-weave{fill:none;stroke:rgba(255,255,255,.07);stroke-width:20;stroke-dasharray:1.5 2.5}
+.pass-swing{position:absolute;left:0;top:0;width:260px;height:440px;transform-origin:128px 250px;transition:transform .6s cubic-bezier(.3,1.6,.5,1)}
+.q4:hover .pass-swing{transform:rotate(3deg)}
+.pass-clip{position:absolute;left:116px;top:246px;width:24px;height:36px;border-radius:4px 4px 3px 3px;background:linear-gradient(90deg,#8d9197,#eceef0 45%,#9ca0a6);box-shadow:0 3px 3px rgba(0,0,0,.2);z-index:3}
+.pass-clip::before{content:"";position:absolute;left:50%;top:-10px;width:12px;height:12px;border:3px solid #a9adb3;border-radius:50%;transform:translateX(-50%)}
+.pass{position:absolute;left:10px;top:272px;width:232px;height:182px;border-radius:9px;border:1px solid rgba(170,180,190,.85);background:linear-gradient(160deg,rgba(255,255,255,.75),rgba(235,240,245,.55));box-shadow:10px 14px 18px -6px rgba(0,0,0,.22),inset 0 0 0 3px rgba(255,255,255,.4);z-index:2}
+.pass::before,.pass::after{content:"";position:absolute;top:12px;width:7px;height:7px;border-radius:50%;background:var(--bg2);border:1px solid #c5ccd3}
+.pass::before{left:44px}.pass::after{right:44px}
+.pass-card{position:absolute;left:12px;right:12px;top:40px;bottom:16px;background:#fbfbfa;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;font-family:var(--serif);color:var(--ink);padding:14px 6px}
+.pass-card::before,.pass-card::after{content:"";position:absolute;left:0;right:0;height:11px;background:var(--navy)}
+.pass-card::before{top:0}.pass-card::after{bottom:0}
+.pass-card strong{font-size:21px;font-weight:700;letter-spacing:.01em;line-height:1.05}
+.pass-card em{font-style:normal;font-size:13.5px;line-height:1.2;letter-spacing:.02em}
+.pass-issued{font:600 9px var(--sans)!important;letter-spacing:.12em!important;margin-top:4px;color:var(--orange)}
+
+/* site footer */
+.site-foot{background:var(--ink);color:#e9e8f0;padding:48px clamp(16px,4vw,40px);display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between}
+.site-foot .brand{color:#fff}
+.site-foot .brand-mark::before{background:#000}
+.foot-mid{font:400 14px var(--sans);opacity:.7}
+.foot-admin{font-size:12px;opacity:.55;text-decoration:none;border-bottom:1px dotted currentColor}
+.foot-admin:hover{opacity:1}
+.site-foot .btn{border-color:#fff;color:#fff}
+.site-foot .btn-ink{background:#fff;color:var(--ink)}
+
+/* ============ MODALS ============ */
+.modal{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:16px;background:rgba(14,18,38,.5);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);opacity:0;transition:opacity .25s}
+.modal.open{opacity:1}
+.m-card{position:relative;width:min(780px,100%);max-height:calc(100vh - 32px);overflow:auto;background:#f8f6f1;border-radius:16px;box-shadow:0 30px 80px -20px rgba(0,0,0,.45);padding:clamp(22px,4vw,40px);transform:translateY(18px) scale(.98);transition:transform .3s cubic-bezier(.2,1,.3,1)}
+.modal.open .m-card{transform:none}
+.m-close{position:absolute;top:14px;right:14px;width:38px;height:38px;border-radius:50%;border:1px solid rgba(16,23,53,.15);background:#fff;cursor:pointer;display:grid;place-items:center;transition:transform .2s,background .2s;z-index:2}
+.m-close:hover{transform:rotate(90deg);background:#f0eee8}
+.m-close svg{width:14px;height:14px}
+.m-eyebrow{font:600 12px var(--sans);letter-spacing:.18em;text-transform:uppercase;color:var(--orange)}
+.m-title{font:600 clamp(26px,4vw,38px)/1.05 var(--serif);text-transform:uppercase;margin:8px 0 10px;padding-right:40px}
+.m-lead{font:400 17px/1.55 var(--sans);color:var(--ink-2);max-width:60ch}
+.m-sec{margin-top:26px}
+.m-h{font:600 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:12px}
+.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}
+.chip{font:600 12.5px var(--sans);letter-spacing:.04em;padding:7px 12px;border-radius:999px;background:#fff;border:1px solid rgba(16,23,53,.12)}
+.chip.hot{background:var(--orange);border-color:var(--orange);color:#fff}
+.tabs{display:flex;gap:6px;padding:5px;background:#ebe8e1;border-radius:999px;margin-top:22px;flex-wrap:wrap}
+.tab{flex:1;min-width:max-content;border:0;background:transparent;padding:10px 16px;border-radius:999px;font:600 14px var(--sans);cursor:pointer;color:var(--ink-2);transition:background .2s,color .2s}
+.tab.active{background:var(--ink);color:#fff}
+.panel{animation:fade .35s ease}
+@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
+.timeline{list-style:none;position:relative;padding-left:22px}
+.timeline::before{content:"";position:absolute;left:5px;top:6px;bottom:6px;width:1px;background:rgba(16,23,53,.2)}
+.timeline li{position:relative;padding:8px 0;font:400 15.5px/1.45 var(--sans)}
+.timeline li::before{content:"";position:absolute;left:-21px;top:14px;width:9px;height:9px;border-radius:50%;background:var(--bg);border:2px solid var(--orange)}
+.timeline b{font-weight:700;display:inline-block;min-width:62px;color:var(--ink)}
+.two-col{display:grid;grid-template-columns:1.3fr 1fr;gap:28px}
+.ticks{list-style:none;display:grid;gap:10px}
+.ticks li{position:relative;padding-left:24px;font:400 15.5px/1.45 var(--sans)}
+.ticks li::before{content:"";position:absolute;left:2px;top:6px;width:10px;height:6px;border-left:2px solid var(--orange);border-bottom:2px solid var(--orange);transform:rotate(-45deg)}
+.m-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
+.note{font:400 13.5px/1.5 var(--sans);color:var(--muted);margin-top:14px}
+
+/* modal photos */
+.m-photo{margin-top:18px;border-radius:14px;overflow:hidden;box-shadow:var(--shadow);background:#e7e2d8}
+.m-photo img{width:100%;height:230px;object-fit:cover}
+.m-photo figcaption{font:500 12.5px var(--sans);color:var(--muted);padding:9px 14px;background:#fff;letter-spacing:.02em}
+
+/* reserve box */
+.reserve-box{margin-top:22px;background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:14px;padding:18px}
+.seat-meter{display:flex;align-items:center;gap:10px;margin:10px 0 14px}
+.seat-meter .track{flex:1;margin:0}
+.seat-meter b{font:700 14px var(--sans);white-space:nowrap}
+
+/* deck */
+.deck{position:relative;margin-top:24px;border-radius:12px;overflow:hidden;background:#fff;box-shadow:0 12px 30px -14px rgba(16,23,53,.35);aspect-ratio:16/9;touch-action:pan-y}
+.slides{display:flex;height:100%;transition:transform .55s cubic-bezier(.6,0,.2,1)}
+.slide{flex:0 0 100%;height:100%;padding:6% 7%;display:flex;flex-direction:column;justify-content:center;gap:10px;position:relative}
+.slide .s-k{font:600 11px var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--orange)}
+.slide h4{font:600 clamp(20px,3.6vw,34px)/1.1 var(--serif)}
+.slide p{font:400 clamp(13px,1.8vw,16px)/1.5 var(--sans);color:var(--ink-2);max-width:46ch}
+.slide.dark{background:var(--ink);color:#fff}
+.slide.dark p{color:#c9cbe0}
+.pyr{display:grid;grid-template-columns:repeat(3,56px);gap:6px;margin-top:8px}
+.pyr span{height:22px;border-radius:4px;background:#e7e4dc}
+.pyr span:first-child{grid-column:1/-1;background:var(--orange)}
+.bars{display:flex;align-items:flex-end;gap:10px;height:90px;margin-top:8px}
+.bars span{width:30px;background:#dcd8cf;border-radius:3px 3px 0 0}
+.bars span.hi{background:var(--orange)}
+.bignum{position:absolute;right:7%;bottom:4%;font:700 clamp(80px,16vw,160px)/1 var(--serif);color:rgba(16,23,53,.07)}
+.deck-bar{position:absolute;left:0;bottom:0;height:3px;background:var(--orange);transition:width .4s}
+.deck-ctrl{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;flex-wrap:wrap}
+.deck-dots{display:flex;gap:7px}
+.deck-dots button{width:9px;height:9px;border-radius:50%;border:0;background:#d6d2c9;cursor:pointer;transition:transform .2s,background .2s}
+.deck-dots button.active{background:var(--ink);transform:scale(1.25)}
+.deck-count{font:600 13px var(--sans);color:var(--muted);min-width:44px;text-align:center}
+.ctrl-group{display:flex;align-items:center;gap:8px}
+.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid rgba(16,23,53,.18);background:#fff;cursor:pointer;display:grid;place-items:center;transition:background .2s,transform .2s}
+.icon-btn:hover:not(:disabled){background:var(--ink);color:#fff}
+.icon-btn:disabled{opacity:.35;cursor:not-allowed}
+.icon-btn svg{width:15px;height:15px}
+.sessions{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
+.session{background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:10px;padding:14px}
+.session b{display:block;font:600 16px var(--serif);margin:4px 0}
+.session span{font:600 11px var(--sans);letter-spacing:.14em;color:var(--orange)}
+.session p{font:400 13.5px/1.4 var(--sans);color:var(--muted)}
+
+/* impact */
+.meter{background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:14px;padding:20px}
+.meter-top{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
+.meter-num{font:700 44px/1 var(--serif)}
+.meter-num small{font:500 16px var(--sans);color:var(--muted);margin-left:6px}
+.track{height:10px;border-radius:99px;background:#ebe8e1;overflow:hidden;margin-top:14px}
+.track i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--orange),#f5a15f);border-radius:99px;transition:width .8s cubic-bezier(.3,1,.3,1)}
+.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+.field{display:flex;flex-direction:column;gap:6px}
+.field.full{grid-column:1/-1}
+.field label,.field .lbl{font:600 12.5px var(--sans);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-2)}
+.field input,.field select,.field textarea{font:400 16px var(--sans);padding:12px 14px;border-radius:10px;border:1px solid rgba(16,23,53,.18);background:#fff;color:var(--ink);transition:border-color .2s,box-shadow .2s;width:100%}
+.field textarea{resize:vertical;min-height:84px}
+.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--ink);box-shadow:0 0 0 3px rgba(16,23,53,.1)}
+.field.err input{border-color:#c62828;box-shadow:0 0 0 3px rgba(198,40,40,.12)}
+.field .err-msg{display:none;font:500 12.5px var(--sans);color:#c62828}
+.field.err .err-msg{display:block}
+.stepper{display:flex;align-items:center;border:1px solid rgba(16,23,53,.18);border-radius:10px;background:#fff;overflow:hidden;width:max-content}
+.stepper button{width:44px;height:46px;border:0;background:transparent;font-size:20px;cursor:pointer}
+.stepper button:hover{background:#f0eee8}
+.stepper output{min-width:40px;text-align:center;font:600 16px var(--sans)}
+.pledges{list-style:none;display:grid;gap:8px;max-height:170px;overflow:auto}
+.pledges li{display:flex;justify-content:space-between;gap:10px;font:400 14.5px var(--sans);padding:10px 12px;border-radius:10px;background:#fff;border:1px solid rgba(16,23,53,.08);animation:fade .4s}
+.pledges li span:last-child{color:var(--muted);white-space:nowrap}
+.pledges li.empty{justify-content:center;color:var(--muted)}
+.shelf{display:grid;grid-template-columns:1fr 1fr;gap:14px}
+.shelf-book{display:flex;gap:14px;padding:16px;border-radius:12px;background:#fff;border:1px solid rgba(16,23,53,.1);transition:box-shadow .3s,border-color .3s}
+.shelf-book.hl-on{border-color:var(--orange);box-shadow:0 0 0 3px rgba(238,106,36,.15)}
+.mini-tome{flex:none;width:30px;height:120px;border-radius:3px;background:linear-gradient(90deg,#b2ac9a,#d0cbba 20%,#aaa38f);display:grid;place-items:center}
+.mini-tome span{writing-mode:vertical-rl;font:500 10px var(--serif);color:#8a6e40;letter-spacing:.05em;white-space:nowrap}
+.shelf-book h5{font:600 18px var(--serif);text-transform:uppercase}
+.shelf-book p{font:400 14px/1.5 var(--sans);color:var(--ink-2);margin-top:6px}
+.shelf-book ul{margin:8px 0 0 16px;font:400 13.5px/1.5 var(--sans);color:var(--muted)}
+
+/* cohort */
+.cohort-grid{display:grid;grid-template-columns:1fr 1fr;gap:26px;align-items:start}
+.pv{position:relative;border-radius:10px;border:1px solid rgba(170,180,190,.85);background:linear-gradient(160deg,rgba(255,255,255,.9),rgba(235,240,245,.6));padding:36px 12px 14px;box-shadow:0 14px 28px -14px rgba(0,0,0,.3)}
+.pv::before{content:"";position:absolute;left:50%;top:10px;width:46px;height:8px;border-radius:5px;transform:translateX(-50%);background:#e3e7eb;border:1px solid #c5ccd3}
+.pv-card{position:relative;background:#fbfbfa;text-align:center;padding:26px 10px;font-family:var(--serif)}
+.pv-card::before,.pv-card::after{content:"";position:absolute;left:0;right:0;height:12px;background:var(--navy)}
+.pv-card::before{top:0}.pv-card::after{bottom:0}
+.pv-card strong{display:block;font-size:24px}
+.pv-card em{display:block;font-style:normal;font-size:14px;margin-top:2px}
+.pv-name{display:block;font:700 18px var(--sans);margin-top:14px;letter-spacing:.02em;word-break:break-word}
+.pv-track{display:inline-block;font:600 10.5px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:#fff;background:var(--orange);padding:4px 9px;border-radius:99px;margin-top:6px}
+.shake{animation:shake .4s}
+@keyframes shake{25%{transform:translateX(-6px)}50%{transform:translateX(5px)}75%{transform:translateX(-3px)}}
+.recent-passes{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
+
+/* join */
+.checks{display:flex;flex-wrap:wrap;gap:8px}
+.check{position:relative}
+.check input{position:absolute;opacity:0;pointer-events:none}
+.check span{display:inline-flex;align-items:center;gap:6px;padding:9px 14px;border-radius:999px;border:1px solid rgba(16,23,53,.18);background:#fff;font:600 13.5px var(--sans);cursor:pointer;transition:.2s}
+.check input:checked + span{background:var(--ink);color:#fff;border-color:var(--ink)}
+.check input:focus-visible + span{outline:2px solid var(--orange);outline-offset:2px}
+.wc-box{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:#fff;border:1px dashed rgba(16,23,53,.3);border-radius:12px;padding:14px 16px;margin-top:18px}
+.wc-box code{font:600 18px ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.02em}
+.done{text-align:center;padding:10px 0}
+.done-icon{width:64px;height:64px;margin:0 auto 14px;border-radius:50%;background:var(--ink);display:grid;place-items:center;animation:pop .5s cubic-bezier(.3,1.6,.5,1)}
+.done-icon svg{width:28px;height:28px;color:#fff}
+@keyframes pop{from{transform:scale(0)}to{transform:scale(1)}}
+
+/* lightbox */
+.lightbox{position:fixed;inset:0;z-index:150;background:rgba(8,10,24,.9);display:grid;place-items:center;padding:20px;opacity:0;transition:opacity .25s}
+.lightbox.open{opacity:1}
+.lightbox figure{max-width:min(920px,94vw);max-height:88vh;display:flex;flex-direction:column;gap:10px}
+.lightbox img{max-width:100%;max-height:76vh;object-fit:contain;border-radius:12px;box-shadow:0 30px 80px rgba(0,0,0,.6)}
+.lightbox figcaption{color:#e9e8f0;font:500 14px var(--sans);text-align:center}
+.lightbox .m-close{position:fixed;top:18px;right:18px}
+
+/* toast, laser, blackout */
+.toast{position:fixed;left:50%;bottom:24px;z-index:200;max-width:min(92vw,520px);transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--ink);color:#fff;font:500 14.5px/1.4 var(--sans);padding:13px 18px;border-radius:12px;box-shadow:0 14px 34px -10px rgba(0,0,0,.45);transition:.3s;text-align:center}
+.toast.show{opacity:1;transform:translate(-50%,0)}
+.laser{position:fixed;left:-7px;top:-7px;width:14px;height:14px;border-radius:50%;z-index:300;pointer-events:none;display:none;background:radial-gradient(circle,#fff 0 15%,#ff2a2a 40%,rgba(255,0,0,0) 72%);box-shadow:0 0 14px 6px rgba(255,30,30,.55)}
+body.laser-on .laser{display:block}
+body.laser-on,body.laser-on *{cursor:none!important}
+.blackout{position:fixed;inset:0;z-index:400;background:#000;color:#555;display:grid;place-items:center;font:500 14px var(--sans);letter-spacing:.1em;text-transform:uppercase;opacity:0;pointer-events:none;transition:opacity .35s}
+.blackout.on{opacity:1;pointer-events:auto;cursor:pointer}
+
+/* reveal */
+.reveal{opacity:0;transform:translateY(24px);transition:opacity .9s ease,transform .9s cubic-bezier(.2,1,.3,1)}
+.reveal.in{opacity:1;transform:none}
+.taglines.reveal > *{opacity:0;transform:translateY(14px);transition:opacity .7s ease,transform .7s ease}
+.taglines.reveal.in > *{opacity:1;transform:none}
+.taglines.reveal.in > *:nth-child(2){transition-delay:.12s}
+.taglines.reveal.in > *:nth-child(3){transition-delay:.24s}
+.taglines.reveal.in > *:nth-child(4){transition-delay:.36s}
+
+/* ============ RESPONSIVE ============ */
+@media (max-width:900px){ .gallery{grid-template-columns:1fr 1fr} .g-item:first-child{grid-column:span 2} }
+@media (max-width:860px){
+  :root{--s:.78}
+  .nav-links{position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;background:rgba(243,241,236,.98);backdrop-filter:blur(10px);padding:8px 20px 20px;box-shadow:0 12px 24px -12px rgba(0,0,0,.2);transform:translateY(-8px);opacity:0;pointer-events:none;transition:.25s}
+  .nav.menu-open .nav-links{transform:none;opacity:1;pointer-events:auto}
+  .nav.menu-open{background:rgba(243,241,236,.98)}
+  .nav-links a{padding:14px 0;border-bottom:1px solid rgba(16,23,53,.08);font-size:14px}
+  .nav-links .btn{margin-top:14px}
+  .burger{display:flex}
+  .two-col,.cohort-grid{grid-template-columns:1fr}
+  .sessions{grid-template-columns:1fr}
+}
+@media (max-width:620px){
+  :root{--s:.56}
+  .form-grid,.shelf{grid-template-columns:1fr}
+  .gallery{grid-template-columns:1fr}
+  .g-item:first-child{grid-column:span 1;aspect-ratio:4/3}
+  .q4 .q-obj{margin-right:-10px;width:calc(100% + 10px)}
+  .m-photo img{height:170px}
+}
+@media (max-width:420px){ :root{--s:.46} }
+@media (prefers-reduced-motion:reduce){
+  *,*::before,*::after{animation:none!important;transition:none!important}
+  html{scroll-behavior:auto}
+  .reveal,.taglines.reveal > *{opacity:1;transform:none}
+}
