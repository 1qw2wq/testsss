diff --git a/public/admin.html b/public/admin.html
new file mode 100644
index 0000000..4426beb
--- /dev/null
+++ b/public/admin.html
@@ -0,0 +1,64 @@
+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8" />
+<meta name="viewport" content="width=device-width, initial-scale=1.0" />
+<title>Admin · Hi World Club</title>
+<meta name="robots" content="noindex, nofollow" />
+<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='10' y='6' width='12' height='22' rx='3' fill='%23ee6a24'/%3E%3Crect x='10' y='2' width='12' height='5' rx='1.5' fill='%23111'/%3E%3C/svg%3E" />
+<link rel="preconnect" href="https://fonts.googleapis.com" />
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap" rel="stylesheet" />
+<link rel="stylesheet" href="/css/admin.css" />
+</head>
+<body>
+<header class="ad-top">
+  <a class="ad-brand" href="/">← Hi World Club</a>
+  <span class="ad-title">Admin dashboard</span>
+  <span class="ad-status" id="adStatus"><span class="dot"></span><span id="adStatusText">Locked</span></span>
+</header>
+
+<main class="ad-main">
+  <!-- token gate -->
+  <section class="ad-gate" id="adGate">
+    <h1>Enter admin token</h1>
+    <p>This is the <code>ADMIN_TOKEN</code> from your server / Vercel environment variables.</p>
+    <form id="adUnlock" class="ad-tokenrow">
+      <input id="adToken" type="password" placeholder="Paste admin token…" autocomplete="off" aria-label="Admin token" />
+      <button class="btn-ink" type="submit">Unlock</button>
+    </form>
+    <p class="ad-err" id="adErr" hidden></p>
+  </section>
+
+  <!-- dashboard -->
+  <section id="adDash" hidden>
+    <div class="ad-bar">
+      <div class="ad-stats" id="adStats" aria-live="polite"></div>
+      <div class="ad-actions">
+        <button id="adRefresh" type="button">↻ Refresh</button>
+        <button id="adLock" type="button">🔒 Lock</button>
+      </div>
+    </div>
+
+    <nav class="ad-tabs" aria-label="Admin sections">
+      <button class="active" data-atab="apps" type="button">Join applications</button>
+      <button data-atab="res" type="button">Trek reservations</button>
+      <button data-atab="pledges" type="button">Book pledges</button>
+      <button data-atab="passes" type="button">Visitor passes</button>
+    </nav>
+
+    <div class="ad-tablewrap">
+      <table class="ad-table">
+        <thead id="adHead"></thead>
+        <tbody id="adBody"></tbody>
+      </table>
+      <p class="ad-empty" id="adEmpty" hidden>No rows yet.</p>
+    </div>
+    <p class="ad-note">Showing up to 200 most recent rows · dates in server time (UTC)</p>
+  </section>
+</main>
+
+<div class="ad-toast" id="adToast" role="status" aria-live="polite"></div>
+<script src="/js/admin.js" defer></script>
+</body>
+</html>
diff --git a/public/css/admin.css b/public/css/admin.css
new file mode 100644
index 0000000..c751e44
--- /dev/null
+++ b/public/css/admin.css
@@ -0,0 +1,48 @@
+/* Hi World Club — admin dashboard */
+:root{
+  --bg:#f3f1ec; --ink:#101735; --ink-2:#2a3150; --muted:#6b6d78;
+  --orange:#ee6a24; --serif:'Source Serif 4',Georgia,serif;
+  --sans:'Source Sans 3',system-ui,-apple-system,sans-serif;
+}
+*{box-sizing:border-box;margin:0;padding:0}
+body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100vh}
+.ad-top{position:sticky;top:0;z-index:10;display:flex;align-items:center;gap:16px;padding:12px clamp(16px,4vw,32px);background:var(--ink);color:#fff}
+.ad-brand{color:#fff;text-decoration:none;font:600 14px var(--serif);letter-spacing:.04em;white-space:nowrap}
+.ad-brand:hover{color:#f5a15f}
+.ad-title{font:600 13px var(--sans);letter-spacing:.14em;text-transform:uppercase;opacity:.75}
+.ad-status{margin-left:auto;display:inline-flex;align-items:center;gap:8px;font:600 12px var(--sans);letter-spacing:.1em;text-transform:uppercase;background:rgba(255,255,255,.1);padding:7px 13px;border-radius:999px}
+.ad-status .dot{width:8px;height:8px;border-radius:50%;background:#e74c3c}
+.ad-status.open .dot{background:#2ecc71}
+.ad-main{max-width:1080px;margin:0 auto;padding:clamp(20px,4vw,36px) clamp(16px,4vw,32px) 60px}
+.ad-gate{max-width:520px;margin:8vh auto 0;background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:18px;padding:clamp(24px,4vw,36px);box-shadow:0 24px 50px -30px rgba(16,23,53,.4);text-align:center}
+.ad-gate h1{font:700 clamp(24px,4vw,32px) var(--serif)}
+.ad-gate p{color:var(--muted);margin-top:8px;font-size:15px}
+.ad-gate code{background:#f0eee8;padding:2px 7px;border-radius:6px;font-size:13.5px}
+.ad-tokenrow{display:flex;gap:10px;margin-top:18px}
+.ad-tokenrow input{flex:1;font:400 16px var(--sans);padding:12px 14px;border-radius:10px;border:1px solid rgba(16,23,53,.2);min-width:0}
+.ad-tokenrow input:focus{outline:none;border-color:var(--ink);box-shadow:0 0 0 3px rgba(16,23,53,.12)}
+.btn-ink{font:600 14px var(--sans);padding:12px 22px;border-radius:999px;border:0;background:var(--ink);color:#fff;cursor:pointer;white-space:nowrap}
+.btn-ink:hover{background:#1d2753}
+.ad-err{color:#c0392b;font-weight:600;margin-top:12px}
+.ad-bar{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-start;justify-content:space-between;margin-bottom:18px}
+.ad-stats{display:grid;grid-template-columns:repeat(4,minmax(130px,1fr));gap:12px;flex:1;min-width:min(100%,560px)}
+.ad-stat{background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:14px;padding:14px 16px}
+.ad-stat b{display:block;font:700 26px/1 var(--serif)}
+.ad-stat b.stat-hl{color:var(--orange)}
+.ad-stat span{font:600 11px var(--sans);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
+.ad-actions{display:flex;gap:8px}
+.ad-actions button{font:600 13.5px var(--sans);padding:10px 16px;border-radius:999px;border:1px solid rgba(16,23,53,.2);background:#fff;cursor:pointer}
+.ad-actions button:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
+.ad-tabs{display:flex;gap:6px;flex-wrap:wrap;background:#ebe8e1;border-radius:999px;padding:5px;margin-bottom:14px}
+.ad-tabs button{flex:1;min-width:max-content;border:0;background:none;padding:10px 16px;border-radius:999px;font:600 14px var(--sans);cursor:pointer;color:var(--ink-2)}
+.ad-tabs button.active{background:var(--ink);color:#fff}
+.ad-tablewrap{background:#fff;border:1px solid rgba(16,23,53,.1);border-radius:14px;overflow:auto;max-height:60vh}
+.ad-table{width:100%;border-collapse:collapse;font-size:14px;min-width:640px}
+.ad-table th{position:sticky;top:0;background:var(--ink);color:#fff;text-align:left;font:600 11.5px var(--sans);letter-spacing:.08em;text-transform:uppercase;padding:11px 14px;white-space:nowrap}
+.ad-table td{padding:10px 14px;border-top:1px solid rgba(16,23,53,.08);vertical-align:top;max-width:320px;overflow-wrap:anywhere}
+.ad-table tbody tr:hover{background:#faf8f3}
+.ad-empty{padding:26px;text-align:center;color:var(--muted)}
+.ad-note{margin-top:10px;color:var(--muted);font-size:13px}
+.ad-toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--ink);color:#fff;font:500 14px var(--sans);padding:12px 18px;border-radius:12px;transition:.3s;max-width:min(92vw,480px);text-align:center}
+.ad-toast.show{opacity:1;transform:translate(-50%,0)}
+@media (max-width:640px){.ad-stats{grid-template-columns:1fr 1fr}.ad-title{display:none}}
diff --git a/public/css/styles.css b/public/css/styles.css
new file mode 100644
index 0000000..7c925ac
--- /dev/null
+++ b/public/css/styles.css
@@ -0,0 +1,494 @@
+/* ==========================================================================
+   Hi World Club — Explore Well  (refined stylesheet v2)
+   Base styles from the original poster + new photo/gallery/API sections.
+   ========================================================================== */
+:root{
+  --bg:#f3f1ec; --bg2:#eeebe5; --ink:#101735; --ink-2:#2a3150; --muted:#6b6d78;
+  --line:#8e8b85; --orange:#ee6a24; --navy:#1c2340; --amber:#9a4e12;
+  --serif:'Source Serif 4', Georgia, 'Times New Roman', serif;
+  --sans:'Source Sans 3', system-ui, -apple-system, Segoe UI, sans-serif;
+  --s:1;
+  --card:#fbfaf7; --shadow:0 18px 44px -22px rgba(16,23,53,.35);
+}
+*{box-sizing:border-box;margin:0;padding:0}
+[hidden]{display:none!important}
+html{scroll-behavior:smooth}
+body{background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:hidden}
+body.lock{overflow:hidden}
+button{font:inherit;color:inherit}
+a{color:inherit}
+img{max-width:100%;display:block}
+:focus-visible{outline:2px solid var(--orange);outline-offset:3px;border-radius:4px}
+
+/* ============ NAV ============ */
+.nav{position:fixed;inset:0 0 auto 0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:14px clamp(16px,4vw,40px);transition:background .3s,box-shadow .3s}
+.nav.scrolled{background:rgba(243,241,236,.88);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 1px 0 rgba(16,23,53,.08)}
+.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--serif);font-weight:600;letter-spacing:.05em;font-size:16px;white-space:nowrap}
+.brand-mark{position:relative;width:12px;height:22px;border-radius:2px 2px 4px 4px;margin-top:5px;background:linear-gradient(90deg,#4a1f03,#c47a2b 40%,#7a3a0a)}
+.brand-mark::before{content:"";position:absolute;left:0;right:0;top:-6px;height:6px;background:#111;border-radius:2px 2px 0 0}
+.nav-links{display:flex;align-items:center;gap:26px}
+.nav-links a{font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;opacity:.72;transition:opacity .2s}
+.nav-links a:hover{opacity:1}
+.burger{display:none;width:40px;height:40px;border:0;background:none;cursor:pointer;flex-direction:column;justify-content:center;align-items:center;gap:5px}
+.burger span{display:block;width:22px;height:2px;background:var(--ink);transition:transform .3s,opacity .3s}
+.nav.menu-open .burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
+.nav.menu-open .burger span:nth-child(2){opacity:0}
+.nav.menu-open .burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
+
+/* ============ BUTTONS ============ */
+.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font:600 14px/1 var(--sans);letter-spacing:.05em;padding:12px 20px;border-radius:999px;border:1px solid var(--ink);background:transparent;color:var(--ink);cursor:pointer;text-decoration:none;transition:transform .2s,background .2s,color .2s,box-shadow .2s}
+.btn:hover{transform:translateY(-1px);box-shadow:0 6px 16px -8px rgba(16,23,53,.5)}
+.btn:active{transform:translateY(0)}
+.btn-ink{background:var(--ink);color:#fff}
+.btn-ink:hover{background:#1d2753}
+.btn-sm{padding:9px 16px;font-size:13px}
+.btn:disabled{opacity:.35;cursor:not-allowed;transform:none;box-shadow:none}
+.btn-busy{opacity:.6;pointer-events:none}
+
+/* ============ POSTER (PAGE 1) ============ */
+.poster{position:relative;isolation:isolate;overflow:clip;min-height:100vh;padding:104px 20px 96px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
+.fit-wrap{width:100%;display:flex;justify-content:center;overflow:visible;transition:transform .3s ease-out;will-change:transform}
+.poster.parallax .fit-wrap{transform:translate3d(calc(var(--px,0)*var(--depth,1)*16px),calc(var(--py,0)*var(--depth,1)*12px),0)}
+.fit{flex:none;transform-origin:top center}
+
+/* ambient hero background */
+.hero-bg{position:absolute;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
+.hero-bg::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(16,23,53,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(16,23,53,.055) 1px,transparent 1px);background-size:46px 46px;-webkit-mask-image:radial-gradient(72% 62% at 50% 28%,#000 25%,transparent 78%);mask-image:radial-gradient(72% 62% at 50% 28%,#000 25%,transparent 78%)}
+.hero-bg i{position:absolute;border-radius:50%;filter:blur(80px);opacity:.6}
+.hero-bg .b1{width:560px;height:560px;left:-160px;top:-140px;background:radial-gradient(circle,#ffd9a8,transparent 65%);animation:drift 17s ease-in-out infinite alternate}
+.hero-bg .b2{width:480px;height:480px;right:-140px;top:6%;background:radial-gradient(circle,#ffc4a3,transparent 65%);animation:drift 21s ease-in-out infinite alternate-reverse}
+.hero-bg .b3{width:640px;height:640px;left:50%;bottom:-320px;transform:translateX(-50%);background:radial-gradient(circle,#ccd6ff,transparent 65%);opacity:.5;animation:drift 24s ease-in-out infinite alternate}
+@keyframes drift{to{transform:translate(46px,34px) scale(1.08)}}
+.hero-bg .b3{animation-name:drift-c}
+@keyframes drift-c{from{transform:translateX(-50%)}to{transform:translateX(calc(-50% + 46px)) translateY(30px) scale(1.06)}}
+
+/* hero eyebrow / sub / cta */
+.hero-eyebrow{display:inline-flex;align-items:center;gap:9px;font:600 12px var(--sans);letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2);background:rgba(255,255,255,.66);border:1px solid rgba(16,23,53,.12);padding:9px 18px;border-radius:999px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);margin-bottom:30px;box-shadow:0 10px 26px -16px rgba(16,23,53,.5)}
+.pulse{width:8px;height:8px;border-radius:50%;background:var(--orange);box-shadow:0 0 0 0 rgba(238,106,36,.5);animation:pulse 2.2s infinite}
+@keyframes pulse{70%{box-shadow:0 0 0 11px rgba(238,106,36,0)}100%{box-shadow:0 0 0 0 rgba(238,106,36,0)}}
+.hero-sub{margin-top:clamp(20px,3vw,28px);font:400 clamp(15px,2vw,18.5px)/1.6 var(--sans);color:var(--ink-2);max-width:58ch}
+.hero-cta{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin:22px 0 clamp(36px,5vw,56px)}
