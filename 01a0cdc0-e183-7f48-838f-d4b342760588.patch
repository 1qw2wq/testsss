+.q1 .q-hint{left:0;top:24px}.q2 .q-hint{right:0;top:24px}.q3 .q-hint{left:0;bottom:22px}.q4 .q-hint{right:0;bottom:22px}
+.q:hover .q-hint,.q:focus-visible .q-hint{opacity:1;transform:none}
