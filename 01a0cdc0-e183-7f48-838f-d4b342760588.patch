+
+/* taglines */
+.taglines{margin:clamp(36px,6vw,64px) 0 clamp(36px,6vw,58px);font-family:var(--serif);font-weight:600;font-size:clamp(19px,3.7vw,40px);line-height:1;letter-spacing:.01em;text-transform:uppercase;color:var(--ink)}
+.taglines span,.taglines a{display:block}
+.taglines > * + *{margin-top:.98em}
+.taglines a{text-decoration:none;display:inline-block;background:linear-gradient(currentColor,currentColor) 0 100%/0 2px no-repeat;padding-bottom:4px;transition:background-size .35s}
+.taglines a:hover{background-size:100% 2px}
+.taglines a.accent{background:linear-gradient(94deg,#ee6a24 5%,#b34700 95%);-webkit-background-clip:text;background-clip:text;color:transparent;-webkit-text-fill-color:transparent;text-decoration:underline;text-decoration-color:rgba(238,106,36,.4);text-decoration-thickness:2px;text-underline-offset:7px;padding-bottom:8px}
+.taglines a.accent:hover{background-size:auto;text-decoration-color:var(--orange)}
+
+/* WORLD composition */
+.world-art{position:relative;width:840px;height:192px}
+.letter{position:absolute;top:0;height:192px;cursor:pointer;transition:transform .35s cubic-bezier(.3,1.6,.5,1);outline:none}
+.letter:hover,.letter:focus-visible{transform:translateY(-8px)}
+.letter.jump{animation:jump .65s ease}
+@keyframes jump{0%{transform:translateY(0)}35%{transform:translateY(-22px) rotate(-2deg)}65%{transform:translateY(3px) rotate(1deg)}100%{transform:translateY(0)}}
+.letter > *{position:absolute}
+.book{border-radius:3px;background:linear-gradient(90deg,rgba(0,0,0,.22),rgba(255,255,255,.15) 22%,rgba(255,255,255,0) 55%,rgba(0,0,0,.2)),var(--c);box-shadow:8px 10px 12px -4px rgba(0,0,0,.28)}
+.book::after{content:"";position:absolute;right:-5px;top:3px;bottom:3px;width:5px;border-radius:0 2px 2px 0;background:repeating-linear-gradient(90deg,#f6f1e6 0 1px,#e2dac8 1px 2px)}
+.book.flat{background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(0,0,0,0) 50%,rgba(0,0,0,.2)),linear-gradient(90deg,var(--c) 0 64%,#fdfdfb 64% 72%,var(--c) 72%)}
+.book.flat::after{right:3px;left:3px;top:-4px;bottom:auto;width:auto;height:4px;background:repeating-linear-gradient(180deg,#f6f1e6 0 1px,#e2dac8 1px 2px)}
+.book.note{background:linear-gradient(90deg,#161616 0 5px,#f4efe4 5px calc(100% - 4px),#161616 calc(100% - 4px))}
+.book.note::after{display:none}
+.pen{border-radius:4px 4px 2px 2px;background:linear-gradient(90deg,#000,#3c3c3c 40%,#0b0b0b);box-shadow:5px 7px 8px -3px rgba(0,0,0,.35)}
+.pen::before{content:"";position:absolute;right:-3px;top:8px;width:3px;height:40px;background:linear-gradient(90deg,#bbb,#eee);border-radius:2px}
+.pen::after{content:"";position:absolute;left:50%;bottom:-9px;border:4px solid transparent;border-top:9px solid #111;transform:translateX(-50%)}
+.hl{border-radius:5px;background:linear-gradient(90deg,#0c0c0c,#383838 40%,#0c0c0c);box-shadow:6px 8px 8px -3px rgba(0,0,0,.35)}
+.hl::before{content:"";position:absolute;left:3px;right:3px;top:30px;height:22px;background:#f4d31f;border-radius:1px}
+.hl.lie{background:linear-gradient(180deg,#0c0c0c,#383838 40%,#0c0c0c)}
+.hl.lie::before{top:3px;bottom:3px;left:74px;right:auto;width:22px;height:auto}
+.rmini{border-radius:14px 14px 12px 12px;background:radial-gradient(circle at 35% 25%,#3c3c3c,#111 60%);box-shadow:6px 8px 10px -3px rgba(0,0,0,.35)}
+.rmini::before{content:"";position:absolute;top:22%;left:50%;width:60%;height:24%;transform:translateX(-50%);border-radius:6px;background:#222;border:1px solid #444}
+.rmini::after{content:"";position:absolute;top:52%;left:50%;width:30%;height:6%;transform:translateX(-50%);border-radius:3px;background:#2a2a2a}
+.block{border:22px solid #f1c232;border-radius:2px;box-shadow:8px 10px 12px -4px rgba(0,0,0,.25),inset 3px 3px 5px rgba(0,0,0,.2)}
+.block::after{content:"";position:absolute;inset:-22px;border-radius:2px;background:linear-gradient(135deg,rgba(255,255,255,.25),transparent 40%,rgba(0,0,0,.1));pointer-events:none}
+.tube{border-radius:2px 9px 9px 2px;border:1px solid rgba(140,150,160,.55);background:linear-gradient(180deg,rgba(255,255,255,.95),rgba(210,218,226,.5) 45%,rgba(255,255,255,.85));box-shadow:4px 6px 8px -3px rgba(0,0,0,.2)}
+.tube::before{content:"";position:absolute;left:-2px;top:-2px;bottom:-2px;width:14px;background:linear-gradient(180deg,#e04040,#9c1a22);border-radius:3px}
+.tube::after{content:"";position:absolute;right:2px;top:2px;bottom:2px;width:34%;border-radius:0 7px 7px 0;background:linear-gradient(180deg,#e9ac4f,#b86b1a);opacity:.85;transition:width .4s}
+.tube.v{border-radius:2px 2px 9px 9px;background:linear-gradient(90deg,rgba(255,255,255,.95),rgba(210,218,226,.5) 45%,rgba(255,255,255,.85))}
+.tube.v::before{left:-2px;right:-2px;top:-2px;bottom:auto;width:auto;height:14px;background:linear-gradient(90deg,#e04040,#9c1a22)}
+.tube.v::after{left:2px;right:2px;bottom:2px;top:auto;width:auto;height:32%;border-radius:0 0 7px 7px;transition:height .4s}
+.letter.slosh .tube::after{width:60%}
+.letter.slosh .tube.v::after{width:auto;height:62%}
+
+/* poster footer */
+.poster-foot{margin-top:clamp(40px,7vw,78px);font-family:var(--sans);font-size:clamp(11.5px,1.75vw,19.5px);line-height:1.3;color:#1c1f2e}
+.poster-foot p{text-transform:uppercase}
+.poster-foot .join-line{text-transform:none;margin-top:.55em}
+.inline-link{background:none;border:0;padding:0;font:inherit;color:inherit;text-transform:inherit;cursor:pointer;background-image:linear-gradient(currentColor,currentColor);background-size:0 1px;background-position:0 100%;background-repeat:no-repeat;transition:background-size .3s}
+.inline-link:hover,.inline-link:focus-visible{background-size:100% 1px}
