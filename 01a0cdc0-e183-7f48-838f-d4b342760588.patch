+.vial{display:block;position:relative;width:32px;height:var(--h);margin-top:13px;border-radius:5px 5px 7px 7px;cursor:pointer;
+  background:linear-gradient(90deg,#4a1f03,#9a4e12 18%,#d98d35 34%,#f0b563 40%,#b86a1f 52%,#7a3a0a 80%,#3e1a02);
