+.moments .sub{font:400 16px/1.6 var(--sans);color:#c9cbe0;max-width:62ch}
+.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px}
+.g-item{position:relative;border:0;padding:0;background:none;cursor:zoom-in;border-radius:14px;overflow:hidden;aspect-ratio:4/3;box-shadow:0 20px 40px -20px rgba(0,0,0,.6)}
+.g-item img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,1,.3,1)}
+.g-item:hover img,.g-item:focus-visible img{transform:scale(1.06)}
+.g-item figcaption{position:absolute;left:0;right:0;bottom:0;padding:26px 14px 12px;text-align:left;font:600 13px var(--sans);letter-spacing:.06em;text-transform:uppercase;color:#fff;background:linear-gradient(transparent,rgba(8,10,24,.78))}
+.g-item:first-child{grid-column:span 2;aspect-ratio:16/8}
+
+/* ============ PILLARS (PAGE 2) ============ */
+.pillars{background:var(--bg2);padding:clamp(60px,9vw,100px) clamp(10px,3vw,24px) clamp(70px,10vw,110px);scroll-margin-top:40px;border-radius:38px 38px 0 0;margin-top:-38px;position:relative;z-index:2}
+.pillar-grid{position:relative;max-width:900px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr}
+.pline{position:absolute;background:var(--line);transition:transform 1.2s cubic-bezier(.6,0,.2,1)}
+.pline.v{left:50%;top:0;bottom:0;width:1px;transform:scaleY(0);transform-origin:top}
+.pline.h{left:0;right:0;top:var(--hy,50%);height:1px;transform:scaleX(0);transform-origin:left}
+.pillar-grid.in .pline{transform:none}
+.q{position:relative;display:flex;flex-direction:column;cursor:pointer;outline:none;transition:opacity .4s;background:none;border:0;text-align:inherit;font:inherit;color:inherit;width:100%}
+.q1{padding:24px clamp(14px,4vw,36px) 30px 0;align-items:flex-end}
+.q2{padding:24px 0 30px clamp(14px,4vw,36px);align-items:flex-start}
+.q3{padding:34px clamp(14px,4vw,36px) 20px 0;align-items:flex-end}
+.q4{padding:34px 0 20px clamp(14px,4vw,36px);align-items:flex-start}
