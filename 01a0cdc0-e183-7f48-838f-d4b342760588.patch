+/* Hi World Club — admin dashboard. Token lives in sessionStorage only. */
+(() => {
+  'use strict';
+  const $ = (s) => document.querySelector(s);
+  const KEY = 'hw_admin_token';
+  let tab = 'apps';
+
+  const esc = (v) =>
+    String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+  let toastT;
+  const toast = (m) => {
+    const t = $('#adToast');
+    t.textContent = m;
+    t.classList.add('show');
+    clearTimeout(toastT);
+    toastT = setTimeout(() => t.classList.remove('show'), 2800);
+  };
+
+  const token = () => sessionStorage.getItem(KEY) || '';
+
+  async function api(path) {
+    const res = await fetch(path, { headers: { 'x-admin-token': token() } });
+    const data = await res.json().catch(() => ({}));
+    if (res.status === 401) throw new Error('Invalid token — check ADMIN_TOKEN and try again.');
+    if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
+    return data;
+  }
+
+  function setLocked(locked, msg) {
+    $('#adGate').hidden = !locked;
+    $('#adDash').hidden = locked;
+    $('#adStatus').classList.toggle('open', !locked);
+    $('#adStatusText').textContent = locked ? 'Locked' : 'Unlocked';
+    const err = $('#adErr');
+    if (msg) { err.textContent = msg; err.hidden = false; }
+    else err.hidden = true;
+  }
+
+  const COLS = {
+    apps: ['#', 'Name', 'WeChat', 'School / org', 'Interests', 'Message', 'Applied'],
+    res: ['#', 'Name', 'WeChat', 'Trek', 'Reserved'],
+    pledges: ['#', 'Name', 'Genre', 'Qty', 'Pledged'],
+    passes: ['#', 'Name', 'Track', 'Issued'],
+  };
+
+  function row(cells) {
+    return `<tr>${cells.map((c) => `<td>${c}</td>`).join('')}</tr>`;
+  }
+
+  function render(d) {
+    $('#adHead').innerHTML = `<tr>${COLS[tab].map((c) => `<th>${c}</th>`).join('')}</tr>`;
+    const body = $('#adBody');
+    let html = '';
+    if (tab === 'apps') {
+      html = d.applications.map((a) =>
+        row([a.id, esc(a.name), esc(a.wc), esc(a.org || '—'), (a.interests || []).map(esc).join(', ') || '—', esc(a.msg || '—'), esc(a.created_at)])
+      ).join('');
+    } else if (tab === 'res') {
+      const names = { alibaba: 'Alibaba HQ', refinery: 'Refinery Island' };
+      html = d.reservations.map((r) =>
+        row([r.id, esc(r.name), esc(r.wc), esc(names[r.trek] || r.trek), esc(r.created_at)])
+      ).join('');
+    } else if (tab === 'pledges') {
+      html = d.pledges.map((p) =>
+        row([p.id, esc(p.name), esc(p.genre), esc(p.qty), esc(p.created_at)])
+      ).join('');
+    } else {
+      html = d.passes.map((p) =>
+        row([p.id, esc(p.name), esc(p.track), esc(p.created_at)])
+      ).join('');
+    }
+    body.innerHTML = html;
+    $('#adEmpty').hidden = html !== '';
+  }
+
+  async function load() {
+    try {
+      const [stats, data] = await Promise.all([
+        api('/api/stats'),
+        tab === 'apps' ? api('/api/applications?limit=200')
+          : tab === 'res' ? api('/api/reservations?limit=200')
+          : tab === 'pledges' ? api('/api/pledges?limit=200')
+          : api('/api/passes/latest?limit=200'),
+      ]);
+      $('#adStats').innerHTML = `
+        <div class="ad-stat"><b class="stat-hl">${stats.books.pledged}<small style="font-size:14px;color:var(--muted)">/${stats.books.goal}</small></b><span>Books pledged</span></div>
+        <div class="ad-stat"><b>${stats.applications}</b><span>Applications</span></div>
+        <div class="ad-stat"><b>${stats.passes}</b><span>Passes issued</span></div>
+        <div class="ad-stat"><b>${stats.reservations.alibaba + stats.reservations.refinery}</b><span>Trek seats taken</span></div>`;
+      render(data);
+    } catch (e) {
+      if (/Invalid token/.test(e.message)) {
+        sessionStorage.removeItem(KEY);
+        setLocked(true, e.message);
+      } else toast(e.message);
+    }
+  }
+
+  $('#adUnlock').addEventListener('submit', async (e) => {
+    e.preventDefault();
+    const v = $('#adToken').value.trim();
+    if (!v) return;
+    sessionStorage.setItem(KEY, v);
+    $('#adToken').value = '';
+    try {
+      await api('/api/applications?limit=1');
+      setLocked(false);
+      load();
+    } catch (err) {
+      sessionStorage.removeItem(KEY);
+      setLocked(true, err.message);
+    }
+  });
+
+  $('#adLock').addEventListener('click', () => {
+    sessionStorage.removeItem(KEY);
+    setLocked(true);
+    toast('Locked. Token cleared from this tab.');
