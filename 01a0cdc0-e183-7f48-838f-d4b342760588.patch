+.scroll-cue{margin-top:34px;width:26px;height:40px;border:1.5px solid rgba(16,23,53,.4);border-radius:14px;position:relative;display:block}
+.scroll-cue::after{content:"";position:absolute;left:50%;top:8px;width:3px;height:7px;border-radius:2px;background:var(--ink);transform:translateX(-50%);animation:cue 1.8s infinite}
+@keyframes cue{0%{opacity:0;transform:translate(-50%,0)}40%{opacity:1}100%{opacity:0;transform:translate(-50%,12px)}}
+
+/* live stats band */
+.stats-band{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:34px}
+.stat-chip{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid rgba(16,23,53,.12);border-radius:999px;padding:8px 14px;font:600 13px var(--sans);box-shadow:0 4px 14px -8px rgba(16,23,53,.4)}
