+.q-obj > *{flex:none;transform:scale(var(--s))}
+.q1 .q-obj{--oh:410px;padding-right:4%}
+.q2 .q-obj{--oh:410px;padding-left:4%}
+.q3 .q-obj{--oh:370px;align-items:flex-start;margin-top:30px;padding-right:4%}
+.q3 .q-obj > *{transform-origin:top center}
+.q4 .q-obj{--oh:440px;align-items:flex-start;justify-content:flex-end;margin-top:calc(-96px * var(--s));margin-right:-30px;width:calc(100% + 30px)}
+.q4 .q-obj > *{transform-origin:top right}
+.q-label{font-family:var(--serif);font-weight:400;font-size:clamp(17px,3.35vw,33px);line-height:1.08;letter-spacing:.01em;text-transform:uppercase;transition:color .3s;white-space:pre-line}
