+.clip::after{content:"";position:absolute;left:50%;bottom:-6px;width:8px;height:8px;border:2px solid #b8bcc1;border-radius:50%;transform:translateX(-50%)}
+.badge{width:62px;height:96px;margin-top:2px;border:1px solid #d9dadd;border-radius:5px;background:linear-gradient(160deg,#fff,#f1f2f4);box-shadow:4px 7px 9px -3px rgba(0,0,0,.25);display:flex;flex-direction:column;align-items:center;padding:8px 5px 5px;cursor:pointer;position:relative;overflow:hidden;transition:transform .2s;font-family:var(--sans)}
