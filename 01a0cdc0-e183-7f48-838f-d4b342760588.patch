+
+/* ============ MOMENTS / GALLERY ============ */
+.moments{background:var(--ink);color:#f2f0ea;padding:clamp(60px,9vw,96px) clamp(16px,4vw,40px);scroll-margin-top:40px;border-radius:38px 38px 0 0;margin-top:-38px;position:relative;z-index:1;box-shadow:0 -24px 50px -30px rgba(16,23,53,.5)}
+.moments-inner{max-width:1080px;margin:0 auto}
