+.stat-chip.offline .dot{background:#c0392b}
+.stat-chip.status{flex-basis:100%;justify-content:center;background:none;border:0;box-shadow:none;padding:0;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
