+.b-role{font:400 4.5px var(--sans);color:#777}
+.barcode{margin-top:auto;width:46px;height:9px;background:repeating-linear-gradient(90deg,#222 0 1px,transparent 1px 2px,#222 2px 4px,transparent 4px 5px,#222 5px 6px,transparent 6px 8px)}
+.avatar{width:26px;height:28px;margin-top:4px;background:#e9eef6;border:1px solid #d5dbe5;display:block}
+.badge .ripple{position:absolute;left:50%;top:40%;width:10px;height:10px;border-radius:50%;border:2px solid var(--orange);transform:translate(-50%,-50%) scale(0);opacity:0;pointer-events:none}
