+.vial.tip{animation:tip .6s ease}
+@keyframes tip{0%{transform:rotate(0)}30%{transform:rotate(-9deg)}60%{transform:rotate(6deg)}100%{transform:rotate(0)}}
+
+.lanyard{width:70px;display:flex;flex-direction:column;align-items:center;transform-origin:50% 0}
