+@keyframes swing{0%{transform:rotate(0)}20%{transform:rotate(4deg)}45%{transform:rotate(-3deg)}70%{transform:rotate(1.5deg)}100%{transform:rotate(0)}}
+.strap{width:70px;height:200px;display:block;overflow:visible;filter:drop-shadow(4px 6px 4px rgba(120,50,10,.25))}
